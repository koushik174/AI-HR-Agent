# ==========================================
# AI-HR-Agent Docker Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ==========================================

# ==========================================
# Required API Keys
# ==========================================

# OpenAI API Key (Required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Tavily API Key (Optional)
# Get your key from: https://tavily.com/
# If not provided, market research will use mock data
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================
# OpenAI Model Configuration (Optional)
# ==========================================

# Model to use (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
#OPENAI_MODEL=gpt-4

# Temperature for responses (0.0-2.0, default: 0.7)
# Lower = more deterministic, Higher = more creative
#OPENAI_TEMPERATURE=0.7

# ==========================================
# Application Configuration (Optional)
# ==========================================

# Maximum concurrent agents (default: 10)
#MAX_AGENTS=10

# Cache timeout in seconds (default: 3600)
#CACHE_TIMEOUT=3600

# Enable debug mode (default: false)
#DEBUG_MODE=false

# ==========================================
# Gradio UI Configuration (Optional)
# ==========================================

# Server host (default: 0.0.0.0 for Docker)
#GRADIO_SERVER_NAME=0.0.0.0

# Server port (default: 7860)
#GRADIO_SERVER_PORT=7860

# Share publicly via Gradio's share feature (default: false)
# WARNING: Only enable for temporary demos, not production!
#GRADIO_SHARE=false
